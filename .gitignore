# Native build outputs
*.so
*.o
*.a
*.whl
CMakeFiles/

# Large examples are distributed as Release assets.
/examples/**/*.tar.gz
/examples/*.zip

# Local integrity reports are not release material.
SHA256SUMS
*.sha256
*.sha1
*.md5

